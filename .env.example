# APP_URL: O link URL de onde esta aplicação está hospedada.
# O AI Studio injeta automaticamente.
# Usado para links auto-referenciais e callbacks.
APP_URL="MY_APP_URL"

# DATABASE_URL: String de conexão MySQL
# Exemplo: mysql://usuario:senha@localhost:3306/nome_do_banco
DATABASE_URL=

# ADMIN_EMAIL: Email do administrador para acesso master (padrão: master@admin.com)
ADMIN_EMAIL=master@admin.com

# ADMIN_SECRET: Senha de administrador para operações globais (padrão: admin123)
ADMIN_SECRET=admin123
